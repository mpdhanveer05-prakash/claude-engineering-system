# Copy to .env and fill values. Never commit .env.

# Core
NODE_ENV=development
APP_ENV=dev
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{project}_dev
DATABASE_POOL_MAX=10

# Cache
REDIS_URL=redis://localhost:6379

# Auth
AUTH_PROVIDER_DOMAIN=
AUTH_PROVIDER_CLIENT_ID=
AUTH_PROVIDER_CLIENT_SECRET=
SESSION_SECRET=

# Email
SENDGRID_API_KEY=
EMAIL_FROM=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature flags
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=

# Anthropic (for AI features inside the app)
ANTHROPIC_API_KEY=
