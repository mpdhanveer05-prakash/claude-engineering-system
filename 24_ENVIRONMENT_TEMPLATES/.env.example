# Universal .env.example
# Copy to .env; never commit .env.

# Core
NODE_ENV=development
APP_ENV=dev                       # dev | preview | staging | prod
APP_NAME=
APP_PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev
DATABASE_POOL_MAX=10

# Cache / queue
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth
AUTH_PROVIDER_DOMAIN=
AUTH_PROVIDER_CLIENT_ID=
AUTH_PROVIDER_CLIENT_SECRET=
SESSION_SECRET=

# Email
EMAIL_PROVIDER=mailhog          # mailhog | sendgrid | resend
SENDGRID_API_KEY=
EMAIL_FROM=

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

# Feature flags
GROWTHBOOK_API_HOST=
GROWTHBOOK_CLIENT_KEY=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_PLAN=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Misc
RATE_LIMIT_PER_MINUTE=60
MAINTENANCE_MODE=false
